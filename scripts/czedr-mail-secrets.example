# Copy to /root/.czedr-mail-secrets on the VPS (chmod 600). Never commit real passwords.
#
# GoDaddy / Microsoft 365 mailbox for @czedr.com (common):
#   MAIL_HOST=smtpout.secureserver.net
#   MAIL_PORT=587
#   MAIL_ENCRYPTION=tls
#
# SendGrid / Brevo: use their SMTP host, user, and API key as password.

MAIL_ENABLED=1
MAIL_HOST=smtpout.secureserver.net
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=noreply@czedr.com
MAIL_PASS=REPLACE_WITH_MAILBOX_PASSWORD
MAIL_FROM=noreply@czedr.com
MAIL_FROM_NAME=CZEDR
MAIL_SUPPORT=support@czedr.com
