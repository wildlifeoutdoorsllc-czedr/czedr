# Gmail SMTP for Czedr — copy to /root/.czedr-mail-secrets (chmod 600)
# Create an App Password: https://myaccount.google.com/apppasswords
# (Google Account must have 2-Step Verification on)

MAIL_ENABLED=1
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=czedrapp@gmail.com
MAIL_PASS=PASTE_16_CHAR_APP_PASSWORD_HERE
MAIL_FROM=czedrapp@gmail.com
MAIL_FROM_NAME=CZEDR
