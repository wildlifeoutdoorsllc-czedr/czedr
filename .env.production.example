# Czedr API — PRODUCTION template
# Copy to .env on the server. Never commit real .env to git.
# See docs/PRODUCTION-SECURITY-CHECKLIST.md for what each variable does.

# --- Required ---
APP_ENV=production
APP_DEBUG=false

# Public HTTPS URL (password-reset emails when SMTP is wired)
APP_PUBLIC_URL=https://api.yourdomain.com

# Rate limits on auth (login, register, PIN, forgot-password). Do not set to 0.
CZEDR_RATE_LIMIT=1

# New signups: SYSTEM credits this many USD cents (100000 = $1,000). Set 0 to disable.
CZEDR_WELCOME_BALANCE_CENTS=100000

# Mix into HKDF for signup/card crypto (v2) and bank vault. Generate 32+ random bytes.
# Example: openssl rand -base64 32
CZEDR_CRYPTO_PEPPER=REPLACE_WITH_OPENSSL_RAND_BASE64_32

# --- Must NOT be set in production (leave commented) ---
# APP_ENV=local
# CZEDR_ALLOW_HTTP=1
# CZEDR_ALLOW_LEDGER_LOAD=1
# CZEDR_RATE_LIMIT=0
# CZEDR_MICRO_DEPOSIT_SKIP_WAIT=1
# CZEDR_ALLOW_PLAIN_AUTH=1   # only during iOS migration; plain /v1/auth/login blocked by default
# CZEDR_ALLOW_LEGACY_API=1   # old /login /signup paths; disabled by default in production

# --- Database (prefer least-privilege user; see scripts/setup-secure-local.sql) ---
# VAULT_USER_SATURN=app_saturn
# VAULT_PASS_SATURN=REPLACE_ME

# --- Optional admin read-only reports (unset = routes return 404) ---
# Header: X-Czedr-Admin-Token or Authorization: Bearer <token>
# CZEDR_ADMIN_REPORT_TOKEN=REPLACE_WITH_64_CHAR_HEX

# --- Ledger economics ---
CZEDR_TRANSFER_FEE_CENTS=129
CZEDR_REFERRAL_REWARD_CENTS=17

# --- Deploy hygiene ---
CZEDR_AUTO_MIGRATE=0

# --- Bank link (micro-deposit only; optional) ---
CZEDR_BANK_LINK_METHOD=microdeposit
# Do not set fixed micro amounts in production (server picks random cents)
# CZEDR_MICRO_DEPOSIT_CENTS_A=
# CZEDR_MICRO_DEPOSIT_CENTS_B=

# --- Moov ACH (optional; keep disabled until configured) ---
MOOV_ENABLED=0
# MOOV_BASE_URL=https://api.moov.io
# MOOV_PUBLIC_KEY=
# MOOV_SECRET_KEY=
# MOOV_PLATFORM_ACCOUNT_ID=
# MOOV_WALLET_ID=
# MOOV_WEBHOOK_SECRET=REPLACE_WHEN_MOOV_ENABLED

# --- ACH limits if Moov enabled ---
# CZEDR_ACH_MIN_CENTS=100
# CZEDR_ACH_MAX_CENTS=500000
# CZEDR_ACH_WITHDRAW_ENABLED=0

# --- Email (password reset; see docs/EMAIL-SETUP.md) ---
# MAIL_ENABLED=1
# MAIL_HOST=smtpout.secureserver.net
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USER=noreply@czedr.com
# MAIL_PASS=
# MAIL_FROM=noreply@czedr.com
# MAIL_FROM_NAME=CZEDR
# MAIL_SUPPORT=support@czedr.com
