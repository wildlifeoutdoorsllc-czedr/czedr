# Czedr — build and upload to TestFlight (no local Mac required)

default_platform(:ios)

platform :ios do
  desc "Archive and upload to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_KEY_ID"),
      issuer_id: ENV.fetch("APPSTORE_ISSUER_ID"),
      key_content: ENV.fetch("APPSTORE_PRIVATE_KEY"),
      is_key_content_base64: false
    )

    # Create/download App Store profile (CI has no profile in Apple portal yet).
    sigh(
      api_key: api_key,
      app_identifier: "com.czedr.app",
      skip_install: false,
      force: true
    )

    profile_uuid = lane_context[SharedValues::SIGH_UUID]
    update_code_signing_settings(
      path: "payooxe.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: "com.czedr.app",
      targets: ["payooxe"],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_uuid: profile_uuid
    )

    build_number = ENV.fetch("GITHUB_RUN_NUMBER", "1")
    increment_build_number(
      xcodeproj: "payooxe.xcodeproj",
      build_number: build_number
    )

  profile_name = lane_context[SharedValues::SIGH_NAME]

    build_app(
      project: "payooxe.xcodeproj",
      scheme: "payooxe",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        uploadSymbols: true,
        provisioningProfiles: {
          "com.czedr.app" => profile_name
        }
      },
      output_directory: "./build",
      output_name: "Czedr",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} IPHONEOS_DEPLOYMENT_TARGET=13.0",
      codesigning_identity: "Apple Distribution",
      skip_package_dependencies_resolution: true,
      disable_package_automatic_updates: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end
