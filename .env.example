# Copy to .env and run: php scripts/generate-env-key.php
APP_ENV=local
APP_DEBUG=false

# 32-byte key, base64-encoded (required for vault encryption)
MASTER_KEY_BASE64=

# Optional: Moov ACH HTTP API (docker) for NACHA export only — no bank settlement
MOOV_ACH_URL=http://127.0.0.1:8081/files

# Planet DB users — run scripts/setup-planet-users.sql then use these locally:
VAULT_USER_MERCURY=vault_mercury
VAULT_PASS_MERCURY=LocalVault_Mercury_2026!
VAULT_USER_VENUS=vault_venus
VAULT_PASS_VENUS=LocalVault_Venus_2026!
VAULT_USER_EARTH=vault_earth
VAULT_PASS_EARTH=LocalVault_Earth_2026!
VAULT_USER_MARS=vault_mars
VAULT_PASS_MARS=LocalVault_Mars_2026!
VAULT_USER_JUPITER=vault_jupiter
VAULT_PASS_JUPITER=LocalVault_Jupiter_2026!
VAULT_USER_SATURN=app_saturn
VAULT_PASS_SATURN=LocalApp_Saturn_2026!
