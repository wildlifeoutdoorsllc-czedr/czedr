# Copy to .env (optional: php scripts/generate-env-key creates .env from this example)
#
# Set to 1 so the HTTP entrypoint runs pending migrations from database/migrations before handling requests.
# Still run `php scripts/run-migrations.php` from deploy scripts when PHP-FPM is used without hitting index.php.
#CZEDR_AUTO_MIGRATE=0
# Use APP_ENV=local only on trusted dev machines. If unset, the API treats the app as production
# (no welcome balance, no reset token in JSON, POST /v1/ledger/load disabled unless flag below).
APP_ENV=local
APP_DEBUG=false

# Set to 1 only for staging/tests to allow POST /v1/ledger/load without APP_ENV=local.
#CZEDR_ALLOW_LEDGER_LOAD=0

# USD cents charged to the sender on each P2P transfer (receiver still receives amount_cents). Set 0 to disable.
CZEDR_TRANSFER_FEE_CENTS=129

# USD cents minted to the referee's single-level referrer when the referee sends a P2P payment (default 17 = $0.17). Set 0 to disable.
CZEDR_REFERRAL_REWARD_CENTS=17

# Optional: least-privilege MySQL user for the `saturn` database (see scripts/setup-secure-local.sql).
# If unset, credentials from config/database.local.php are used.
#VAULT_USER_SATURN=app_saturn
#VAULT_PASS_SATURN=change_me

# Optional: long random secret for read-only GET /v1/admin/revenue-ledger (Bearer or X-Czedr-Admin-Token).
# Leave unset to disable the route (returns 404).
#CZEDR_ADMIN_REPORT_TOKEN=

# Production API URL (used in password-reset links for local sandbox only).
#APP_PUBLIC_URL=https://api.yourdomain.com

# Rate limiting on auth endpoints (login, register, PIN, forgot-password). Set 0 to disable.
#CZEDR_RATE_LIMIT=1

# Allow HTTP in production (only behind a TLS-terminating proxy that sets X-Forwarded-Proto: https).
# Leave unset in production; APP_ENV=local always allows HTTP for home Wi-Fi testing.
#CZEDR_ALLOW_HTTP=0

# Optional server pepper mixed into HKDF info for image-bound AES-GCM (v2) payloads. Use 32+ random bytes in production.
#CZEDR_CRYPTO_PEPPER=

# Moov ACH funding (add money from bank). See docs/MOOV-ACH-FUNDING.md
#MOOV_ENABLED=0
#MOOV_BASE_URL=https://api.moov.io
#MOOV_PUBLIC_KEY=
#MOOV_SECRET_KEY=
#MOOV_PLATFORM_ACCOUNT_ID=
#MOOV_WALLET_ID=
#MOOV_WEBHOOK_SECRET=
#CZEDR_ACH_MIN_CENTS=100
#CZEDR_ACH_MAX_CENTS=500000
