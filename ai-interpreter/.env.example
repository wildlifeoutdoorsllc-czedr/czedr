# Copy to .env and fill in keys for backends you use.
INTERPRETER_HOST=127.0.0.1
INTERPRETER_PORT=8790
INTERPRETER_API_KEY=

# Default backend (openai_compat works with OpenAI, Ollama, LM Studio, etc.)
DEFAULT_BACKEND=openai

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional second backend (set id in requests or use broadcast)
ANTHROPIC_BACKEND_ID=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.openai.com/v1
ANTHROPIC_MODEL=gpt-4o-mini

# Ollama example (uncomment and set DEFAULT_BACKEND=ollama)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
